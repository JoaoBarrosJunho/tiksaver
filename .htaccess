Options -Indexes
RewriteEngine on


RewriteRule ^panel/$ ./index.php?p=panel [NC]
RewriteRule ^panel/([a-z0-9^(.*)$-_]+)$ ./index.php?p=panel&zone=$1 [NC,QSA]

RewriteRule ^logs.txt ./index.php?p=404 [NC,QSA]
RewriteRule ^.env ./ [NC]
RewriteRule ^composer.json ./index.php?p=404 [NC,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d



RewriteRule ^(.*)$ ./index.php?p=$1 [NC,QSA]




